# Copy to .env and change values before any shared deployment.
SECRET_KEY=replace-with-a-long-random-value
PORT=5000
FLASK_DEBUG=0
PREFLOOD_DB=database/preflood.db
# Optional: set these to create one local admin account at first startup.
PREFLOOD_ADMIN_EMAIL=admin@preflood.local
PREFLOOD_ADMIN_PASSWORD=replace-this-local-password
# Optional: Google Maps Platform API Key for Google Maps & Routes integration.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

